{
  "openapi": "3.0.3",
  "info": { "title": "Orders API", "version": "1.0.0" },
  "servers": [{ "url": "https://orders.example.com/api/v1" }],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders for fulfillment",
        "responses": {
          "200": {
            "description": "Customer orders",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["new", "fulfilled"] }
        }
      }
    }
  }
}
